# Production values (docs/MY-CHANGES.md section 10). Copy to apps/web/.env.prod,
# which is git-ignored and never loaded by Next.js, so local dev and builds
# can't reach production by accident. The same file feeds the jobs function
# (`pnpm functions:deploy:prod`), migrations (`pnpm db:migrate:prod`), storage
# CORS (`pnpm storage:cors:prod`), and Vercel ("Import .env" on the project's
# Environment Variables page, Production only).
# Never paste these values into chat; fill them with the commands below.

# --- Filled by `pnpm env:pull:prod` (after `pnpm functions:deploy:prod`) ---
DATABASE_URL=
# Migrations only; harmless on Vercel.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# The jobs function's URL; the app uses it when FUNCTIONS_URL is empty.
NEON_FUNCTION_JOBS_BASE_URL=

# --- New secrets: `pnpm env:secret <NAME> --file apps/web/.env.prod` ---
NEON_AUTH_COOKIE_SECRET=
VISITOR_TOKEN_SECRET=
FUNCTIONS_SECRET=
# Shared with the Worker: add `--also apps/realtime/.env.prod`.
REALTIME_TOKEN_SECRET=
REALTIME_PUBLISH_SECRET=

# --- Copied from apps/web/.env.local without printing it:
#     pnpm env:secret GOOGLE_GENERATIVE_AI_API_KEY --file apps/web/.env.local --also apps/web/.env.prod
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Not secret: `pnpm env:set <NAME> <value> --file apps/web/.env.prod` ---
# The production Worker, after `pnpm realtime:deploy:prod`.
REALTIME_URL=
NEXT_PUBLIC_REALTIME_HOST=
# The Vercel production URL, e.g. https://supportdesk.vercel.app
NEXT_PUBLIC_APP_URL=
# Comma-separated owner emails, or "*" for anyone. Empty means nobody can sign up in production.
OWNER_EMAILS=
# Neon's shared Google keys are development only.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Optional overrides; leave empty to use AWS_ENDPOINT_URL_S3 and NEON_FUNCTION_JOBS_BASE_URL.
STORAGE_PUBLIC_BASE_URL=
FUNCTIONS_URL=
