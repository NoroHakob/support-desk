# Fill with `neon env pull --project-id <id> --branch development --service postgres --service auth --file apps/web/.env.local`.
# Server-only. Never prefix any of these with NEXT_PUBLIC_.

# Postgres (Neon). The app uses the pooled URL; Prisma migrations use the unpooled one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random characters, generated locally (not provided by Neon)
NEON_AUTH_COOKIE_SECRET=
