# Fill with `neon env pull --project-id <id> --branch development --service postgres --service auth --file apps/web/.env.local`.
# Server-only, except NEXT_PUBLIC_ values, which reach the browser: never give a secret that prefix.

# Postgres (Neon). The app uses the pooled URL; Prisma migrations use the unpooled one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random characters, generated locally (not provided by Neon)
NEON_AUTH_COOKIE_SECRET=
# Owner allowlist: comma-separated emails that may sign up and open the dashboard.
# "*" means anyone may sign up. Empty means everyone in development and nobody in production.
# Visitors are unaffected.
OWNER_EMAILS=
# Set to false to hide "Continue with Google" (production has no Google keys yet).
NEXT_PUBLIC_GOOGLE_SIGN_IN=

# Object Storage (Neon). Fill with `neon env pull --project-id <id> --branch development -s object-storage --file apps/web/.env.local`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Public base for profile-images objects (not secret). Optional: defaults to AWS_ENDPOINT_URL_S3.
STORAGE_PUBLIC_BASE_URL=

# The app's own origin, for storage CORS (`pnpm --filter @marshaldesk/web storage:cors`). Not secret.
NEXT_PUBLIC_APP_URL=

# Signs visitor tokens (jose, HS256). 32+ random bytes: `pnpm env:secret VISITOR_TOKEN_SECRET`.
VISITOR_TOKEN_SECRET=

# Real time (apps/realtime). Both secrets are shared with the Worker:
#   pnpm env:secret REALTIME_TOKEN_SECRET --also apps/realtime/.dev.vars
#   pnpm env:secret REALTIME_PUBLISH_SECRET --also apps/realtime/.dev.vars
REALTIME_TOKEN_SECRET=
REALTIME_PUBLISH_SECRET=
# The Worker's URL for publishing (server-only), e.g. https://supportdesk-realtime-dev.<account>.workers.dev
REALTIME_URL=
# The same Worker's host for browser sockets (not secret), e.g. supportdesk-realtime-dev.<account>.workers.dev
NEXT_PUBLIC_REALTIME_HOST=

# Gemini (docs/MY-CHANGES.md section 3). Server-only; also uploaded to the jobs function.
GOOGLE_GENERATIVE_AI_API_KEY=
# Dev only: set to 1 to make every agent call fail like a Gemini 429 (hands off, no Gemini call). Ignored in production.
AGENT_SIMULATE_429=

# The jobs Neon Function (apps/functions, declared in neon.ts). The secret is shared with it:
#   pnpm env:secret FUNCTIONS_SECRET
FUNCTIONS_SECRET=
# Its invocation URL (not secret), from `neon functions get jobs --project-id <id> --branch development`.
# Optional when NEON_FUNCTION_JOBS_BASE_URL was pulled with `neon env pull --service functions`.
FUNCTIONS_URL=
