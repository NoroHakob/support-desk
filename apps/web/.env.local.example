# Fill with `neon env pull --project-id <id> --branch development --service postgres --service auth --file apps/web/.env.local`.
# Server-only, except NEXT_PUBLIC_ values, which reach the browser: never give a secret that prefix.

# Postgres (Neon). The app uses the pooled URL; Prisma migrations use the unpooled one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random characters, generated locally (not provided by Neon)
NEON_AUTH_COOKIE_SECRET=

# Object Storage (Neon). Fill with `neon env pull --project-id <id> --branch development -s object-storage --file apps/web/.env.local`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Public base for profile-images objects: the branch's storage endpoint (not secret).
STORAGE_PUBLIC_BASE_URL=

# The app's own origin, for storage CORS (`pnpm --filter @marshaldesk/web storage:cors`). Not secret.
NEXT_PUBLIC_APP_URL=

# Signs visitor tokens (jose, HS256). 32+ random bytes: `pnpm env:secret VISITOR_TOKEN_SECRET`.
VISITOR_TOKEN_SECRET=
