# Secrets for the production Worker (supportdesk-realtime). Never commit the
# filled-in .env.prod. Fill both together with apps/web/.env.prod:
#   pnpm env:secret REALTIME_TOKEN_SECRET --file apps/web/.env.prod --also apps/realtime/.env.prod
#   pnpm env:secret REALTIME_PUBLISH_SECRET --file apps/web/.env.prod --also apps/realtime/.env.prod
# Then upload them with `pnpm realtime:secrets:prod`.
REALTIME_TOKEN_SECRET=
REALTIME_PUBLISH_SECRET=
