// use prisma-8

types {
  Embedding = pgvector.Vector(1024)
}

enum MemberRole {
  @@type("pg/text@1")
  owner = "owner"
}

enum WidgetPosition {
  @@type("pg/text@1")
  bottomLeft  = "bottom-left"
  bottomRight = "bottom-right"
}

enum WidgetColor {
  @@type("pg/text@1")
  blue   = "blue"
  indigo = "indigo"
  violet = "violet"
  pink   = "pink"
  red    = "red"
  orange = "orange"
  green  = "green"
}

enum SourceKind {
  @@type("pg/text@1")
  file = "file"
  text = "text"
}

enum SourceStatus {
  @@type("pg/text@1")
  uploaded   = "uploaded"
  processing = "processing"
  ready      = "ready"
  failed     = "failed"
}

model Workspace {
  id                        Uuid                     @id @onCreate(uuid())
  name                      String
  widgetPosition            WidgetPosition           @default(bottomRight) @map("widget_position")
  widgetColor               WidgetColor              @default(blue) @map("widget_color")
  agentName                 String                   @map("agent_name")
  agentAvatarKey            String?                  @map("agent_avatar_key")
  greeting                  String                   @default("Hi there! How can we help you today?")
  allowedDomains            String[]                 @default(sql`'{}'`) @map("allowed_domains")
  suggestedQuestions        String[]                 @default(sql`'{}'`) @map("suggested_questions")
  snippetInstalledAt        TimestamptzJsDate?       @map("snippet_installed_at")
  // Bumped whenever the chunks change. Suggested questions record the version
  // they were generated from, so a batch of uploads regenerates them once.
  knowledgeVersion          Int                      @default(0) @map("knowledge_version")
  suggestedQuestionsVersion Int                      @default(0) @map("suggested_questions_version")
  createdAt                 temporal.CreatedAtJsDate @map("created_at")
  updatedAt                 temporal.UpdatedAtJsDate @map("updated_at")

  @@map("workspaces")
}

model Member {
  id          Uuid                     @id @onCreate(uuid())
  workspaceId Uuid                     @map("workspace_id")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      Uuid                     @unique @map("user_id")
  role        MemberRole
  // Copied from the Neon Auth user, so visitors see who's replying.
  name        String?
  imageUrl    String?                  @map("image_url")
  createdAt   temporal.CreatedAtJsDate @map("created_at")

  @@index([workspaceId])
  @@map("members")
}

model Source {
  id          Uuid                     @id @onCreate(uuid())
  workspaceId Uuid                     @map("workspace_id")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        SourceKind
  name        String
  storageKey  String?                  @map("storage_key")
  text        String?
  mime        String?
  size        Int?
  status      SourceStatus             @default(uploaded)
  error       String?
  // Claimed by each ingest run, so only the latest run may swap the chunks.
  revision    Int                      @default(0)
  // ETag of the file the current chunks came from; a repeated trigger for the
  // same object is skipped.
  etag        String?
  createdAt   temporal.CreatedAtJsDate @map("created_at")
  updatedAt   temporal.UpdatedAtJsDate @map("updated_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, name], unique: true, where: sql`(kind = 'file')`, name: "sources_workspace_file_name_key")
  @@map("sources")
}

model Chunk {
  id          Uuid                     @id @onCreate(uuid())
  workspaceId Uuid                     @map("workspace_id")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    Uuid                     @map("source_id")
  source      Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  position    Int
  content     String
  // Unit length, so cosine similarity is a plain dot product.
  embedding   Embedding
  createdAt   temporal.CreatedAtJsDate @map("created_at")

  @@index([workspaceId])
  @@index([sourceId, position])
  @@map("chunks")
}

enum VisitorDevice {
  @@type("pg/text@1")
  desktop = "desktop"
  mobile  = "mobile"
  tablet  = "tablet"
}

enum ConversationState {
  @@type("pg/text@1")
  ai      = "ai"
  waiting = "waiting"
  human   = "human"
  closed  = "closed"
}

enum HandoffReason {
  @@type("pg/text@1")
  low_confidence        = "low_confidence"
  no_relevant_knowledge = "no_relevant_knowledge"
  visitor_requested     = "visitor_requested"
  agent_off             = "agent_off"
}

enum MessageAuthor {
  @@type("pg/text@1")
  visitor = "visitor"
  agent   = "agent"
  member  = "member"
  system  = "system"
}

enum SystemEvent {
  @@type("pg/text@1")
  greeting    = "greeting"
  handoff     = "handoff"
  taken_over  = "taken_over"
  handed_back = "handed_back"
  closed      = "closed"
}

enum Classification {
  @@type("pg/text@1")
  support_question = "support_question"
  small_talk       = "small_talk"
  off_topic        = "off_topic"
  human_request    = "human_request"
}

model Visitor {
  id              Uuid                     @id @onCreate(uuid())
  workspaceId     Uuid                     @map("workspace_id")
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SHA-256 of the token's `vsk` claim; the token itself is never stored.
  tokenSecretHash String                   @map("token_secret_hash")
  country         String?
  city            String?
  timezone        String?
  language        String?
  device          VisitorDevice?
  browser         String?
  os              String?
  page            String?
  referrer        String?
  visitCount      Int                      @default(1) @map("visit_count")
  firstSeenAt     temporal.CreatedAtJsDate @map("first_seen_at")
  lastSeenAt      TimestamptzJsDate        @map("last_seen_at")

  @@index([workspaceId])
  @@map("visitors")
}

model Conversation {
  id                   Uuid                     @id @onCreate(uuid())
  workspaceId          Uuid                     @map("workspace_id")
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitorId            Uuid                     @map("visitor_id")
  visitor              Visitor                  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  state                ConversationState
  handoffReason        HandoffReason?           @map("handoff_reason")
  lastMessageAt        TimestamptzJsDate        @map("last_message_at")
  lastVisitorMessageAt TimestamptzJsDate?       @map("last_visitor_message_at")
  memberReadAt         TimestamptzJsDate?       @map("member_read_at")
  createdAt            temporal.CreatedAtJsDate @map("created_at")
  closedAt             TimestamptzJsDate?       @map("closed_at")
  messages             Message[]

  @@index([workspaceId, lastMessageAt])
  @@index([visitorId, createdAt])
  // A visitor has at most one open conversation (PRD Flow C).
  @@index([visitorId], unique: true, where: sql`(state <> 'closed')`, name: "conversations_one_open_per_visitor")
  @@map("conversations")
}

model Message {
  id             Uuid              @id @onCreate(uuid())
  conversationId Uuid              @map("conversation_id")
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspaceId    Uuid              @map("workspace_id")
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author         MessageAuthor
  memberId       Uuid?             @map("member_id")
  member         Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  body           String            @default("")
  systemEvent    SystemEvent?      @map("system_event")
  classification Classification?
  declined       Boolean           @default(false)
  attachments    Jsonb             @default(json`[]`)
  agentTurns     AgentTurn[]
  // Set by the app, not the database, so messages written in one transaction
  // keep their order.
  createdAt      TimestamptzJsDate @map("created_at")

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("messages")
}

enum AgentOutcome {
  @@type("pg/text@1")
  answered   = "answered"
  replied    = "replied"
  declined   = "declined"
  handed_off = "handed_off"
  discarded  = "discarded"
}

// A copy of what retrieval returned, so the log outlives deleted sources.
type RetrievedChunk {
  chunkId    Uuid
  sourceId   Uuid
  sourceName String
  score      Float
  used       Boolean
}

// One row per agent turn (PRD AI-11), on the visitor message it answered.
model AgentTurn {
  id             Uuid                     @id @onCreate(uuid())
  workspaceId    Uuid                     @map("workspace_id")
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId      Uuid                     @map("message_id")
  message        Message                  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // The agent's reply, when the turn wrote one.
  replyMessageId Uuid?                    @map("reply_message_id")
  outcome        AgentOutcome
  chunks         RetrievedChunk[]
  model          String
  tokensIn       Int                      @map("tokens_in")
  tokensOut      Int                      @map("tokens_out")
  latencyMs      Int                      @map("latency_ms")
  error          String?
  createdAt      temporal.CreatedAtJsDate @map("created_at")

  @@index([messageId])
  @@index([workspaceId])
  @@map("agent_turns")
}
