{
  "name": "@marshaldesk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "migrate:dev": "prisma db migrate --advance-ref db",
    "migrate:show": "prisma db migrate --show",
    "migrate:prod": "prisma db migrate --advance-ref production"
  },
  "dependencies": {
    "@marshaldesk/shared": "workspace:*",
    "@prisma/orm-extension-pgvector": "8.0.0-rc.20",
    "@prisma/orm-postgres": "8.0.0-rc.20"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/node": "^24",
    "dotenv": "^18.0.9",
    "prisma": "8.0.0-rc.26",
    "typescript": "^5"
  }
}
