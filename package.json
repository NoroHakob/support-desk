{
  "name": "marshaldesk",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @marshaldesk/web dev",
    "build": "pnpm --filter @marshaldesk/web build",
    "realtime:dev": "pnpm --filter @marshaldesk/realtime run dev",
    "realtime:deploy:dev": "pnpm --filter @marshaldesk/realtime run deploy:dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:set": "node scripts/env.mjs set",
    "env:secret": "node scripts/env.mjs secret"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
