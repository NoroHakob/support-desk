{
  "name": "marshaldesk",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @marshaldesk/web dev",
    "build": "pnpm --filter @marshaldesk/web build",
    "realtime:dev": "pnpm --filter @marshaldesk/realtime run dev",
    "realtime:deploy:dev": "pnpm --filter @marshaldesk/realtime run deploy:dev",
    "realtime:deploy:prod": "pnpm --filter @marshaldesk/realtime run deploy:prod",
    "realtime:secrets:prod": "pnpm --filter @marshaldesk/realtime run secrets:prod",
    "functions:plan:dev": "neon config plan --project-id cool-surf-05710594 --branch development --env apps/web/.env.local",
    "functions:deploy:dev": "neon deploy --project-id cool-surf-05710594 --branch development --env apps/web/.env.local",
    "functions:plan:prod": "neon config plan --project-id cool-surf-05710594 --branch production --env apps/web/.env.prod",
    "functions:deploy:prod": "neon deploy --project-id cool-surf-05710594 --branch production --env apps/web/.env.prod --no-env-pull",
    "env:pull:prod": "neon env pull --project-id cool-surf-05710594 --branch production --service postgres --service auth --service object-storage --service functions --file apps/web/.env.prod",
    "db:migrate:show:prod": "node scripts/with-env-file.mjs apps/web/.env.prod pnpm --filter @marshaldesk/db migrate:show",
    "db:migrate:prod": "node scripts/with-env-file.mjs apps/web/.env.prod pnpm --filter @marshaldesk/db migrate:prod",
    "storage:cors:prod": "node scripts/with-env-file.mjs apps/web/.env.prod pnpm --filter @marshaldesk/web storage:cors",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:set": "node scripts/env.mjs set",
    "env:secret": "node scripts/env.mjs secret",
    "gemini:ping": "node apps/web/scripts/gemini-ping.mjs"
  },
  "devDependencies": {
    "@neon/config": "1.9.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
